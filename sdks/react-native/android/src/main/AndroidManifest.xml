<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+ (API 31+) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 trở xuống -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!--
        ACCESS_FINE_LOCATION (quét BLE trên Android 11 trở xuống) app tự khai báo. Thư viện khai kèm maxSdkVersion="30" thì
        Gradle giữ giới hạn đó trên dòng quyền đã gộp, app dùng GPS sẽ mất vị trí chính xác trên Android 12+.
    -->

    <!-- required="false": app có thể dùng thư viện cho tính năng phụ; Google Play không lọc máy không có BLE. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!--
        Chỉ gồm phần tối thiểu: Bluetooth + giữ kết nối khi chạy nền. Cầu nối điện thoại (READ_PHONE_STATE, dịch vụ
        PhoneNotificationListener, SEND_SMS, READ_CALL_LOG…) app tự khai báo khi dùng, xem docs/huong-dan-su-dung.md.
        Thiếu thì tính năng tương ứng bỏ qua, không crash (manifest sdks/core vẫn khai báo đủ cho app lab).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.smartwear.core.phone.KeepConnectedService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
