{
  "name": "react-native-smartwear",
  "version": "0.1.0",
  "description": "React Native TurboModule cho SmartWear SDK: nhẫn/vòng QRing (Colmi R0x, DS500), đồng hồ GloryFit/UTE (Y25, HT43), thiết bị Bluetooth chuẩn",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "react-native-smartwear.podspec",
    "react-native.config.js",
    "vendor",
    "scripts/vendor.js",
    "!android/build",
    "!ios/build"
  ],
  "license": "UNLICENSED",
  "private": true,
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react-native": "0.79.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/vendor.js",
    "postpack": "node -e \"require('fs').rmSync('vendor',{recursive:true,force:true})\""
  },
  "codegenConfig": {
    "name": "RNSmartWearSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.smartwear.rn"
    }
  }
}
