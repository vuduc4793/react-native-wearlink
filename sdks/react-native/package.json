{
  "name": "react-native-wearlink",
  "version": "0.1.1",
  "description": "React Native TurboModule (Android + iOS) kết nối điện thoại với thiết bị đeo: đồng hồ GloryFit/UTE (Y25), vòng tay Veepoo (GE54), nhẫn QRing, thiết bị Bluetooth chuẩn — đo, lịch sử, cài đặt, thông báo, cuộc gọi, nhạc, báo thức",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "react-native-wearlink.podspec",
    "react-native.config.js",
    "vendor",
    "scripts/vendor.js",
    "!android/build",
    "!ios/build"
  ],
  "license": "UNLICENSED",
  "private": false,
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react-native": "0.79.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/vendor.js",
    "postpack": "node -e \"require('fs').rmSync('vendor',{recursive:true,force:true})\""
  },
  "codegenConfig": {
    "name": "RNSmartWearSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.smartwear.rn"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuduc4793/react-native-wearlink.git",
    "directory": "sdks/react-native"
  },
  "homepage": "https://github.com/vuduc4793/react-native-wearlink#readme",
  "keywords": [
    "react-native",
    "wearable",
    "smartwatch",
    "bluetooth",
    "ble",
    "gloryfit",
    "veepoo",
    "qring",
    "health"
  ]
}
