{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react-native": [
        "./example/node_modules/react-native"
      ],
      "react-native/*": [
        "./example/node_modules/react-native/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
